generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Roles de usuario para el sistema
enum Role {
  USER
  ADMIN
}

// Modelo de Usuarios
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

